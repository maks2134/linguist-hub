PORT=8080
APP_ENV=development
ENABLE_SWAGGER=true

# Local Docker Postgres OR Neon/Railway URL (either works)
DB_DSN=host=localhost user=postgres password=postgres dbname=linguistai port=5432 sslmode=disable
# DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

JWT_SECRET=your_jwt_secret_key_change_this_in_production
GEMINI_API_KEY=your_gemini_api_key_here
LOG_LEVEL=info

# Comma-separated browser origins (Vercel production + previews)
ALLOWED_ORIGINS=http://localhost:3000

FEATURE_SERVER_STT=false
